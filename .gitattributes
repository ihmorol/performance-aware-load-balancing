# Keep config files byte-identical on every OS, so the recorded config hash
# depends only on the content and not on how git checked the file out.
*.toml text eol=lf

# Never convert line endings inside papers and deliverables.
*.pdf binary
*.pptx binary
*.docx binary

# Scripts, units, and the sudo rule run on Linux VMs.
*.sh text eol=lf
*.service text eol=lf
implementation/setup/plb-sudoers text eol=lf
